# Copy to .env and fill in. Validated at startup by src/shared/lib/env.ts.

# PostgreSQL (docker compose up -d postgres). DATABASE_URL is accepted as a fallback (Vercel Neon integration).
DATABASE_URI=postgres://shoot:shoot@127.0.0.1:5432/shoot

# At least 32 random characters: openssl rand -hex 32
PAYLOAD_SECRET=
# Absolute public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret for the editor draft-preview route
PREVIEW_SECRET=
# Bearer token the scheduler sends to /api/cron/cleanup
CRON_SECRET=

# First admin created by `pnpm seed` when no users exist
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Production media storage (all or none)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_HOST=

# Vercel Blob for media only (used when S3 is not set). Blob is public-only, so identity documents
# are never stored there: they need S3/R2 above.
BLOB_READ_WRITE_TOKEN=

# App links (feature 008): the association files at /.well-known. Each file answers 404 until its
# variables are set. iOS: comma-separated TEAMID.bundle.id values. Android: the package name and the
# comma-separated SHA-256 fingerprints (AA:BB:…) of the signing certificates (Play App Signing included).
APP_IOS_APP_IDS=
APP_ANDROID_PACKAGE=
APP_ANDROID_CERT_SHA256=

# Sign-in by one-time code (feature 009, specs/009-otp-sign-in/contracts/otp-provider.md).
# OTP_HMAC_SECRET keys the stored fingerprints of codes and numbers (openssl rand -hex 32); at least 32
# characters, required in production, separate from PAYLOAD_SECRET so either can rotate alone.
OTP_HMAC_SECRET=
# console (default outside production) writes each code to apps/web/.otp-outbox/<challengeId>.json;
# read the newest with `pnpm --filter web otp:last`. It is refused in a production deployment.
# unifonic needs the four variables below, all or none (pending the owner's approval, research R10).
OTP_PROVIDER=
# Six digits: every code issued is this one (local testing only; refused in production).
OTP_FIXED_CODE=
# 1 lets a deployed (production) site accept OTP_FIXED_CODE and the console provider. Anyone who knows
# the code can sign in as any number: throwaway test deployments only, never with real users.
OTP_ALLOW_FIXED_CODE=
# Multiplies every hourly OTP limit (default 1: 5 codes per number, 10 per install, 20 per address,
# 30 checks per address). 10 gives 50 codes per number an hour.
OTP_RATE_LIMIT_MULTIPLIER=
UNIFONIC_APP_SID=
# The registered alphanumeric SMS sender name.
OTP_SMS_SENDER_ID=
# The WhatsApp Business number and the approved authentication template name (en and ar).
OTP_WHATSAPP_SENDER=
OTP_WHATSAPP_TEMPLATE=

# Set to true when building without database access (Docker image builds)
# SKIP_BUILD_STATIC_GENERATION=true

# Local development and e2e only: also create 24 demo creators (src/shared/payload/seed/demo-creators.data.ts)
# with illustrated portraits, gender, nationality and experience; samples are placeholder images.
# Refused unless NEXT_PUBLIC_SITE_URL is localhost, 127.0.0.1, *.localhost or *.test. Never set in a deployment.
# SEED_DEMO_CREATORS=1
# SEED_DEMO_RESET=1    # local only: first remove every demo creator (@demo.test) with their bookings and briefs
# SEED_DEMO_GUIDES=1   # local only: demo guides, authors and an intent page (refused on other hosts)
