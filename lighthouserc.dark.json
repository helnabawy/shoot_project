{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter web start",
      "startServerReadyPattern": "Ready|started server",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/ar",
        "http://localhost:3000/creators",
        "http://localhost:3000/creators/d2222",
        "http://localhost:3000/work/portrait",
        "http://localhost:3000/ar/creators",
        "http://localhost:3000/ar/creators/d2222",
        "http://localhost:3000/ar/work/portrait",
        "http://localhost:3000/studios",
        "http://localhost:3000/ar/studios",
        "http://localhost:3000/terms",
        "http://localhost:3000/ar/terms",
        "http://localhost:3000/privacy",
        "http://localhost:3000/ar/privacy",
        "http://localhost:3000/guides",
        "http://localhost:3000/ar/guides",
        "http://localhost:3000/guides/demo-guide-27",
        "http://localhost:3000/ar/guides/demo-guide-27",
        "http://localhost:3000/hire/proposal-photographer-dubai",
        "http://localhost:3000/ar/hire/proposal-photographer-dubai"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": "--no-sandbox --headless=new --force-dark-mode --blink-settings=preferredColorScheme=0"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-dark"
    }
  }
}
