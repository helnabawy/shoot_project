{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter web start",
      "startServerReadyPattern": "Ready|started server",
      "url": ["http://localhost:3000/", "http://localhost:3000/ar"],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": "--no-sandbox --headless=new --force-dark-mode --blink-settings=preferredColorScheme=0"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci-dark" }
  }
}
